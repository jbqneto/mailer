{
  "name": "email-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central email gateway with versioned React Email templates and SMTP delivery.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "ENV_FILE=.env.local tsx watch src/server.ts",
    "dev:purelymail": "ENV_FILE=.env tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/config/projects.json dist/src/config/projects.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:dev": "email dev --dir emails --port 3001",
    "smtp:verify": "tsx src/scripts/verify-smtp.ts",
    "smtp:verify:local": "ENV_FILE=.env.local tsx src/scripts/verify-smtp.ts"
  },
  "dependencies": {
    "typescript": "7.0.2",
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "nodemailer": "9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "tsx": "4.22.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
