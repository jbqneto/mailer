# Copy to .env for Purelymail/staging configuration.
# For local Mailpit, use the committed .env.local through Docker Compose.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DELIVERY_STORE=memory
# Required only when DELIVERY_STORE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password

# Purelymail SMTP: port 465 + SECURE=true, or port 587 + SECURE=false.
# Use a dedicated mailbox and its App Password for each project.
BLOOM_APP_API_KEY=replace-with-at-least-32-random-characters
BLOOM_APP_FROM_EMAIL=bloom@purelymail.com
BLOOM_APP_FROM_NAME=Bloom
BLOOM_APP_REPLY_TO=
BLOOM_APP_SMTP_HOST=smtp.purelymail.com
BLOOM_APP_SMTP_PORT=465
BLOOM_APP_SMTP_SECURE=true
BLOOM_APP_SMTP_AUTH=true
BLOOM_APP_SMTP_USER=bloom@purelymail.com
BLOOM_APP_SMTP_PASSWORD=replace-with-bloom-app-password

PONTEBR_API_KEY=replace-with-at-least-32-random-characters
PONTEBR_FROM_EMAIL=pontebr@purelymail.com
PONTEBR_FROM_NAME=PonteBR
PONTEBR_REPLY_TO=
PONTEBR_SMTP_HOST=smtp.purelymail.com
PONTEBR_SMTP_PORT=465
PONTEBR_SMTP_SECURE=true
PONTEBR_SMTP_AUTH=true
PONTEBR_SMTP_USER=pontebr@purelymail.com
PONTEBR_SMTP_PASSWORD=replace-with-pontebr-app-password

BLOCOS_E_BITS_API_KEY=replace-with-at-least-32-random-characters
BLOCOS_E_BITS_FROM_EMAIL=blocos-e-bits@purelymail.com
BLOCOS_E_BITS_FROM_NAME=Blocos e Bits
BLOCOS_E_BITS_REPLY_TO=
BLOCOS_E_BITS_SMTP_HOST=smtp.purelymail.com
BLOCOS_E_BITS_SMTP_PORT=465
BLOCOS_E_BITS_SMTP_SECURE=true
BLOCOS_E_BITS_SMTP_AUTH=true
BLOCOS_E_BITS_SMTP_USER=blocos-e-bits@purelymail.com
BLOCOS_E_BITS_SMTP_PASSWORD=replace-with-blocos-e-bits-app-password

JBQNETO_API_KEY=replace-with-at-least-32-random-characters
JBQNETO_FROM_EMAIL=jbqneto@purelymail.com
JBQNETO_FROM_NAME=JBQ Neto
JBQNETO_REPLY_TO=
JBQNETO_SMTP_HOST=smtp.purelymail.com
JBQNETO_SMTP_PORT=465
JBQNETO_SMTP_SECURE=true
JBQNETO_SMTP_AUTH=true
JBQNETO_SMTP_USER=jbqneto@purelymail.com
JBQNETO_SMTP_PASSWORD=replace-with-jbqneto-app-password
