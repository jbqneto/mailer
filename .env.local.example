# Copy this file to .env.local for local Mailpit development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DELIVERY_STORE=memory
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-admin-password

BLOOM_APP_API_KEY=replace-with-a-32-character-local-key-bloom
BLOOM_APP_FROM_EMAIL=bloom@local.test
BLOOM_APP_FROM_NAME=Bloom Local
BLOOM_APP_REPLY_TO=
BLOOM_APP_SMTP_HOST=localhost
BLOOM_APP_SMTP_PORT=1025
BLOOM_APP_SMTP_SECURE=false
BLOOM_APP_SMTP_AUTH=false
BLOOM_APP_SMTP_USER=
BLOOM_APP_SMTP_PASSWORD=

PONTEBR_API_KEY=replace-with-a-32-character-local-key-pontebr
PONTEBR_FROM_EMAIL=pontebr@local.test
PONTEBR_FROM_NAME=PonteBR Local
PONTEBR_REPLY_TO=
PONTEBR_SMTP_HOST=localhost
PONTEBR_SMTP_PORT=1025
PONTEBR_SMTP_SECURE=false
PONTEBR_SMTP_AUTH=false
PONTEBR_SMTP_USER=
PONTEBR_SMTP_PASSWORD=

BLOCOS_E_BITS_API_KEY=replace-with-a-32-character-local-key-blocos
BLOCOS_E_BITS_FROM_EMAIL=blocos-e-bits@local.test
BLOCOS_E_BITS_FROM_NAME=Blocos e Bits Local
BLOCOS_E_BITS_REPLY_TO=
BLOCOS_E_BITS_SMTP_HOST=localhost
BLOCOS_E_BITS_SMTP_PORT=1025
BLOCOS_E_BITS_SMTP_SECURE=false
BLOCOS_E_BITS_SMTP_AUTH=false
BLOCOS_E_BITS_SMTP_USER=
BLOCOS_E_BITS_SMTP_PASSWORD=

JBQNETO_API_KEY=replace-with-a-32-character-local-key-jbqneto
JBQNETO_FROM_EMAIL=jbqneto@local.test
JBQNETO_FROM_NAME=JBQ Neto Local
JBQNETO_REPLY_TO=
JBQNETO_SMTP_HOST=localhost
JBQNETO_SMTP_PORT=1025
JBQNETO_SMTP_SECURE=false
JBQNETO_SMTP_AUTH=false
JBQNETO_SMTP_USER=
JBQNETO_SMTP_PASSWORD=
